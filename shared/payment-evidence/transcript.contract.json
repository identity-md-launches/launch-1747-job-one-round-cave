{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy",
    "reads"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tx",
        "recipient",
        "minimum_raw",
        "token",
        "confirmations",
        "finalized"
      ],
      "properties": {
        "tx": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "recipient": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "minimum_raw": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "token": {
          "type": "string",
          "enum": [
            "ZTO",
            "IMD"
          ]
        },
        "confirmations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "finalized": {
          "type": "boolean"
        }
      }
    },
    "reads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "method",
          "params"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "eth_chainId",
              "eth_getBlockByNumber",
              "eth_getTransactionReceipt"
            ]
          },
          "params": {
            "type": "array",
            "maxItems": 2
          }
        }
      }
    }
  }
}
